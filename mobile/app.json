{
  "expo": {
    "name": "Sombra",
    "slug": "sombra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF7EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      "expo-asset",
      "expo-sqlite",
      "expo-secure-store",
      "expo-background-task",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Sombra usa sua localização só para mostrar o lugar fresco mais perto e a direção até ele."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Sombra usa a câmera só para ler o QR da Sentinela."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Sombra usa o Face ID para proteger os dados das casas neste celular."
        }
      ]
    ],
    "scheme": "sombra",
    "experiments": {
      "typedRoutes": true
    }
  }
}
