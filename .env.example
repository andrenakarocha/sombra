# Sombra · variáveis de ambiente
# Copie para .env com `make env`: ele gera os segredos vazios e nunca sobrescreve um valor que você já preencheu.
# O .env nunca vai para o Git. Contrato: docs/contratos/README.md.
# As strings de conexão dos serviços são montadas pelo compose a partir das senhas abaixo (sem duplicar senha).

# ── PostgreSQL ───────────────────────────────────────────────────────────────────
POSTGRES_USER=sombra_admin
POSTGRES_PASSWORD=
CORE_DB_PASSWORD=
CLIMA_DB_PASSWORD=
# porta do banco no host (dentro do compose é sempre db:5432)
DB_PORTA_LOCAL=55432

# ── Core API (.NET: Secao__Chave) ────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
Jwt__Emissor=sombra-core
Jwt__Segredo=
Mqtt__Host=localhost
Mqtt__Porta=1883
Mqtt__PrefixoTopico=sombra/v1
Clima__UrlBase=http://localhost:8081
# 32 bytes em base64: cifra de PII em repouso e índice cego
Privacidade__ChaveAes=
Privacidade__ChaveIndiceCego=
# Ligada | Desligada (Desligada só é aceita no ambiente Demo, para a auditoria antes × depois)
Privacidade__Aplicacao=Ligada
# token do monitor da VM para POST /api/v1/ops/alertas
Ops__TokenDoMonitor=
# senha das contas da demonstração (ana.filha, marcos.filho, operador e admin @demo.sombra)
Demo__Senha=
# o relógio do Core se adianta pela API (POST /api/v1/demo/relogio/avancar, Admin, só em Development e Demo)

# ── IA da tradução de risco (D7) ─────────────────────────────────────────────────
GEMINI_API_KEY=
# P5 conferida em 2026-11-18: Flash-Lite estável, 1–2 s (os Flash maiores davam 503/timeout). Vazio usa este padrão.
Gemini__Modelo=gemini-3.5-flash-lite

# ── Clima Service (Spring) ───────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
# a coleta ao vivo (a cada 10 min, sem chave); false desliga e o Clima segue só com o que já gravou
CLIMA_OPEN_METEO_HABILITADO=true
CLIMA_OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
CLIMA_MODELO_CAMINHO=modelo/modelo-calor-v1.onnx

# ── Clientes (visíveis no navegador e no celular: nada secreto aqui) ────────────
VITE_API_URL=http://localhost:5080
EXPO_PUBLIC_API_URL=http://localhost:5080

# ── Simulador da Sentinela (tools/sentinela-sim) ────────────────────────────────
# a Sentinela do seed (casa da Dona Lurdes); o Core usa o mesmo segredo para ela
SENTINELA_DEVICE_ID=snt-7f3a9c
# 32 bytes em hexadecimal; o Core gera um por Sentinela no vínculo
SENTINELA_SEGREDO_HEX=
# chave do código de vínculo do QR (tools/vinculo/codigo.py); o Core confere o código com ela
SENTINELA_CHAVE_DE_VINCULO=
MQTT_HOST=localhost
MQTT_PORTA=1883
