# Sombra · variáveis de ambiente
# Copie para .env (o .env nunca vai para o Git). Contrato: docs/contratos/README.md.
# Valores "troque-me" e chaves vazias precisam ser gerados; o `make env` (F0.10) faz isso sozinho.

# ── PostgreSQL (compose) ─────────────────────────────────────────────────────────
POSTGRES_USER=sombra_admin
POSTGRES_PASSWORD=troque-me
CORE_DB_PASSWORD=troque-me
CLIMA_DB_PASSWORD=troque-me

# ── Core API (.NET: Secao__Chave) ────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Core=Host=localhost;Port=5432;Database=sombra_core;Username=sombra_core;Password=troque-me
Jwt__Emissor=sombra-core
# pelo menos 32 caracteres aleatórios
Jwt__Segredo=troque-me
Mqtt__Host=localhost
Mqtt__Porta=1883
Mqtt__PrefixoTopico=sombra/v1
Clima__UrlBase=http://localhost:8081
# 32 bytes em base64 (openssl rand -base64 32): cifra de PII em repouso e índice cego
Privacidade__ChaveAes=
Privacidade__ChaveIndiceCego=
# Ligada | Desligada (Desligada só é aceita no ambiente Demo, para a auditoria antes × depois)
Privacidade__Aplicacao=Ligada
# token do monitor da VM para POST /api/v1/ops/alertas
Ops__TokenDoMonitor=troque-me
# 1 = tempo real; 60 = um minuto vira um segundo (só no ambiente Demo)
Demo__EscalaDeTempo=1

# ── IA da tradução de risco (D7) ─────────────────────────────────────────────────
GEMINI_API_KEY=
# o modelo é fixado na F2.6, depois de conferir a P5
Gemini__Modelo=

# ── Clima Service (Spring) ───────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sombra_clima
SPRING_DATASOURCE_USERNAME=sombra_clima
SPRING_DATASOURCE_PASSWORD=troque-me
CLIMA_OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
CLIMA_MODELO_CAMINHO=modelo/modelo-calor-v1.onnx

# ── Clientes (visíveis no navegador e no celular: nada secreto aqui) ────────────
VITE_API_URL=http://localhost:5080
EXPO_PUBLIC_API_URL=http://localhost:5080

# ── Simulador da Sentinela (tools/sentinela-sim) ────────────────────────────────
SENTINELA_DEVICE_ID=snt-000001
# 32 bytes em hexadecimal; o Core gera um por Sentinela no vínculo
SENTINELA_SEGREDO_HEX=
MQTT_HOST=localhost
MQTT_PORTA=1883
